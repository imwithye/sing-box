#!/usr/bin/env bash
# sing-box-ctl — one-binary VLESS+REALITY + Hysteria2 deployment wrapper.
#
# Talks straight to the upstream sing-box release binary + a systemd unit.
# No Docker, no compose plugin, no Go runtime: just bash + curl + systemd.

set -euo pipefail

# ─── repo / upstream ────────────────────────────────────────────────────────
REPO_API="${SINGBOX_REPO_API:-https://api.github.com/repos/SagerNet/sing-box}"
REPO_DL="${SINGBOX_REPO_DL:-https://github.com/SagerNet/sing-box}"

# ─── paths ──────────────────────────────────────────────────────────────────
CONFIG_DIR="${SINGBOX_CONFIG_DIR:-/etc/sing-box}"
ENV_FILE="$CONFIG_DIR/env"
CONFIG_FILE="$CONFIG_DIR/config.json"
TSEXIT_FILE="$CONFIG_DIR/tsexit"
TSDNS_FILE="$CONFIG_DIR/tsdns"
CACHE_DIR="$CONFIG_DIR/cache"
CLIENT_DIR="$CONFIG_DIR/client"
UNIT_FILE="/etc/systemd/system/sing-box.service"
SINGBOX_BIN="/usr/local/bin/sing-box"
WRAPPER_BIN="/usr/local/bin/sing-box-ctl"

# Loopback gRPC API service, rendered only while tailscale is enabled. It is
# how `ts status/login/logout` reach the running endpoint — the login state
# lives in the process, not in config.json.
API_ADDR="${SINGBOX_API_ADDR:-127.0.0.1}"
API_PORT="${SINGBOX_API_PORT:-6756}"

# ─── pretty output ──────────────────────────────────────────────────────────
if [[ -t 1 && "${NO_COLOR:-}" == "" ]]; then
  C_RESET=$'\033[0m'   C_DIM=$'\033[2m'    C_BOLD=$'\033[1m'
  C_RED=$'\033[31m'    C_GREEN=$'\033[32m' C_YELLOW=$'\033[33m'
  C_BLUE=$'\033[34m'
else
  C_RESET= C_DIM= C_BOLD= C_RED= C_GREEN= C_YELLOW= C_BLUE=
fi

header()  { printf '\n%s%s%s\n'   "${C_BOLD}"   "$*" "${C_RESET}"; }
subhead() { printf '%s%s%s\n'    "${C_BOLD}"   "$*" "${C_RESET}"; }
step()    { printf '  %s→%s %s\n' "${C_BLUE}"   "${C_RESET}" "$*"; }
ok()      { printf '  %s✓%s %s\n' "${C_GREEN}"  "${C_RESET}" "$*"; }
warn()    { printf '  %s!%s %s\n' "${C_YELLOW}" "${C_RESET}" "$*"; }
err()     { printf '  %s✗%s %s\n' "${C_RED}"    "${C_RESET}" "$*" >&2; }
hint()    { printf '  %s%s%s\n'   "${C_DIM}"    "$*"        "${C_RESET}"; }
ask()     { printf '  %s?%s %s '  "${C_BLUE}"   "${C_RESET}" "$*"; }
has_tty() { [[ -e /dev/tty && -r /dev/tty ]]; }
# read_tty VARNAME — read one line from the terminal into VARNAME, empty on
# EOF. Prompts read /dev/tty, not stdin, so `curl | bash` can still ask.
read_tty() { read -r "$1" </dev/tty || printf -v "$1" '%s' ""; }
die()     { err "$*"; exit 1; }

# ─── prerequisites ──────────────────────────────────────────────────────────
require_root() {
  [[ $EUID -eq 0 ]] || die "must run as root — try: sudo sing-box-ctl ${1:-}"
}

require_cmd() {
  command -v "$1" >/dev/null 2>&1 || die "$1 not found in PATH"
}

# ─── embedded templates (heredocs keep this file self-contained) ────────────
