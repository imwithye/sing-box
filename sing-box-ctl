SERVER_VARS=(
  DOMAIN ACME_EMAIL CF_API_TOKEN
  REALITY_DEST_SNI REALITY_DEST_PORT
  VLESS_UUID
  REALITY_PRIVATE_KEY REALITY_PUBLIC_KEY REALITY_SHORT_ID
  HYSTERIA2_PASSWORD HYSTERIA2_OBFS_PASSWORD
)
# Client vars are what a Shadowrocket import / share link needs.
CLIENT_VARS=(
  DOMAIN REALITY_DEST_SNI VLESS_UUID
  REALITY_PUBLIC_KEY REALITY_SHORT_ID
  HYSTERIA2_PASSWORD HYSTERIA2_OBFS_PASSWORD
)

# ─── secret generators ──────────────────────────────────────────────────────
# Only ever called from fill_secrets, which runs after install_singbox_binary,
# so $SINGBOX_BIN is always present.
gen_uuid()            { "$SINGBOX_BIN" generate uuid | tr -d '\r\n'; }
gen_reality_keypair() { "$SINGBOX_BIN" generate reality-keypair; }
gen_short_id()        { openssl rand -hex 8; }
gen_password()        { openssl rand -base64 24 | tr -d '=+/\n' | cut -c1-24; }

# ─── arch detection ─────────────────────────────────────────────────────────
detect_arch() {
  case "$(uname -m)" in
    x86_64|amd64) echo amd64 ;;
    aarch64|arm64) echo arm64 ;;
    armv7l) echo armv7 ;;
    *) die "unsupported arch: $(uname -m)" ;;
  esac
}

# ─── upstream sing-box ──────────────────────────────────────────────────────
latest_version() {
  curl -fsSL "$REPO_API/releases/latest" \
    | grep '"tag_name"' \
    | head -n1 \
    | sed -E 's/.*"v([^"]+)".*/\1/'
}

installed_version() {
  [[ -x "$SINGBOX_BIN" ]] || return 0
  "$SINGBOX_BIN" version 2>/dev/null | awk '/sing-box version/ {print $3}'
}

install_singbox_binary() {
  require_cmd curl
  require_cmd tar
  local version arch tarball url tmp
  version="${1:-$(latest_version)}"
  [[ -n "$version" ]] || die "could not determine latest sing-box release"

  if [[ "$(installed_version)" == "$version" ]]; then
    ok "sing-box ${version} already installed — skipping download"
    return 0
  fi

  arch="$(detect_arch)"
  tarball="sing-box-${version}-linux-${arch}.tar.gz"
  url="$REPO_DL/releases/download/v${version}/${tarball}"

  step "Downloading sing-box ${version} (${arch})"
  tmp="$(mktemp -d)"
  curl -fsSL "$url" -o "$tmp/sb.tgz"
  tar xzf "$tmp/sb.tgz" -C "$tmp"
  install -m 0755 "$tmp/sing-box-${version}-linux-${arch}/sing-box" "$SINGBOX_BIN"
  rm -rf "$tmp"
  ok "installed $SINGBOX_BIN (sing-box $version)"
}

install_systemd_unit() {
  step "Writing $UNIT_FILE"
  emit_systemd_unit > "$UNIT_FILE"
  systemctl daemon-reload
  systemctl enable sing-box >/dev/null 2>&1 || true
  ok "unit installed + enabled"
}

# ─── host prep (BBR + UFW) ──────────────────────────────────────────────────
detect_os() {
  [[ -r /etc/os-release ]] || die "/etc/os-release missing — unknown OS"
  # shellcheck disable=SC1091
  source /etc/os-release
  OS_PRETTY="${PRETTY_NAME:-${ID:-unknown} ${VERSION_ID:-}}"
  IS_DEBIAN_LIKE=0
  case "${ID:-}" in
    ubuntu|debian) IS_DEBIAN_LIKE=1 ;;
    *) [[ "${ID_LIKE:-}" =~ (debian|ubuntu) ]] && IS_DEBIAN_LIKE=1 ;;
  esac
}

setup_bbr() {
  header "TCP BBR"
  local current avail
  current="$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null || echo unknown)"
  avail="$(sysctl -n net.ipv4.tcp_available_congestion_control 2>/dev/null || echo '')"
  ok "current: $current"
  ok "available: $avail"
  if [[ "$current" == "bbr" ]]; then
    ok "BBR already active — skipping"
    return 0
  fi
  if ! grep -qw bbr <<< "$avail"; then
    step "Loading tcp_bbr module"
    if ! modprobe tcp_bbr 2>/dev/null; then
      warn "kernel does not expose tcp_bbr — likely too old (need >= 4.9)"
      return 1
    fi
  fi
  step "Writing /etc/sysctl.d/99-bbr.conf"
  cat > /etc/sysctl.d/99-bbr.conf <<'EOF'
# Managed by sing-box-ctl — TCP BBR for sing-box egress
net.core.default_qdisc = fq
net.ipv4.tcp_congestion_control = bbr
EOF
  sysctl --system >/dev/null
  current="$(sysctl -n net.ipv4.tcp_congestion_control)"
  [[ "$current" == "bbr" ]] || die "expected bbr, got '$current'"
  ok "BBR active"
}

ufw_allow() { ufw allow "$1" comment "$2" >/dev/null; }

# ufw drives the firewall; qrencode lets `share` render inline QR codes;
# jq patches the rendered config when optional features (tailscale) are on.
SYSTEM_PKGS=(ufw qrencode jq)

setup_packages() {
  header "System packages"
  if [[ $IS_DEBIAN_LIKE -ne 1 ]]; then
    warn "$OS_PRETTY — apt auto-install skipped"
    hint "install manually: ${SYSTEM_PKGS[*]}"
    return 0
  fi
  local pkg missing=()
  for pkg in "${SYSTEM_PKGS[@]}"; do
    command -v "$pkg" >/dev/null || missing+=("$pkg")
  done
  if (( ${#missing[@]} == 0 )); then
    ok "${SYSTEM_PKGS[*]} already installed"
    return 0
  fi
  step "Installing ${missing[*]}"
  apt-get update -qq
  DEBIAN_FRONTEND=noninteractive apt-get install -y -qq "${missing[@]}" >/dev/null
  ok "installed: ${missing[*]}"
}

setup_ufw() {
  header "UFW firewall"
  if [[ $IS_DEBIAN_LIKE -ne 1 ]]; then
    warn "$OS_PRETTY — UFW auto-config skipped"
    hint "open these ports manually with your firewall tooling:"
    hint "    22/tcp  ssh"
    hint "    443/tcp sing-box VLESS-REALITY"
    hint "    443/udp sing-box Hysteria2"
    return 0
  fi
  ufw --force default deny incoming  >/dev/null
  ufw --force default allow outgoing >/dev/null
  ufw_allow 22/tcp  ssh
  ufw_allow 443/tcp 'sing-box vless-reality'
  ufw_allow 443/udp 'sing-box hysteria2'
  ufw --force enable >/dev/null
  ok "ufw active (22/tcp, 443/tcp, 443/udp open)"
}

# ─── render config ──────────────────────────────────────────────────────────
# Patch the rendered config to add a tailscale endpoint, DNS server, route
# rule, and the loopback API service the `ts` subcommands drive. Activated
# only when TS_ENABLED is truthy. Hostname falls back to the first DNS label
# of DOMAIN.
patch_config_tailscale() {
  require_cmd jq
  local host="${TS_HOSTNAME:-${DOMAIN%%.*}}" state="$CACHE_DIR/tailscale"
  # taildrop_directory (sing-box 1.14.0+) defaults to a relative "Taildrop",
  # which resolves against the unit's working directory (/) and fails under
  # ProtectSystem=strict — pin it inside the cache dir instead.
  local taildrop="$state/Taildrop"
  mkdir -p "$state" "$taildrop"

  # The API service — and so the `ts` subcommands — needs sing-box 1.14.0+.
  local installed
  installed="$(installed_version)"
  if [[ -n "$installed" ]] \
     && [[ "$(printf '%s\n' 1.14.0 "$installed" | sort -V | head -1)" != "1.14.0" ]]; then
    die "tailscale support needs sing-box 1.14.0+ (installed: $installed) — run 'sing-box-ctl upgrade'"
  fi

  # Gates loopback access to the control API; generated once, then reused.
  [[ -n "${API_SECRET:-}" ]] || set_env API_SECRET "$(gen_password)"

  parse_tsexit
  parse_tsdns
  local domains_json cidrs_json tsdns_json
  # ${A[@]+"${A[@]}"} expands to nothing, rather than tripping `set -u`, when
  # the array is empty — which any of these three usually is.
  domains_json=$(json_array ${TSEXIT_DOMAINS[@]+"${TSEXIT_DOMAINS[@]}"})
  cidrs_json=$(json_array ${TSEXIT_CIDRS[@]+"${TSEXIT_CIDRS[@]}"})
  tsdns_json=$(json_array ${TSDNS_DOMAINS[@]+"${TSDNS_DOMAINS[@]}"})

  # Note: tsexit $domains intentionally only patched into route.rules, never
  # dns.rules. Letting public domains resolve via the exit node's tailnet DNS
  # breaks Claude web (TLS errors); cloudflare-doh + tailscale-ep route works.
  # Reconfirmed 2026-05-10 — do not re-add $domains to the DNS rule.
  # $tsdns (from the tsdns file) is the deliberate opt-in for the other case:
  # private names whose records only exist inside the tailnet. Those need the
  # DNS rule *and* the route rule, so they go into both.
  local patched
  patched=$(jq \
    --arg     key       "${TS_AUTH_KEY:-}" \
    --arg     host      "$host" \
    --arg     state     "$state" \
    --arg     taildrop  "$taildrop" \
    --arg     exit      "${TS_EXIT_NODE:-}" \
    --arg     apiaddr   "$API_ADDR" \
    --argjson apiport   "$API_PORT" \
    --arg     apisecret "$API_SECRET" \
    --argjson domains   "$domains_json" \
    --argjson cidrs     "$cidrs_json" \
    --argjson tsdns     "$tsdns_json" '
      .endpoints = ((.endpoints // []) + [
        ({
          type: "tailscale",
          tag: "tailscale-ep",
          hostname: $host,
          state_directory: $state,
          taildrop_directory: $taildrop,
          ephemeral: false
        }
        # Omitting auth_key entirely (not setting it empty) is what selects
        # interactive login: sing-box then waits for the URL that
        # `sing-box-ctl ts login` surfaces.
        + (if $key  == "" then {} else {auth_key:  $key}  end)
        + (if $exit == "" then {} else {exit_node: $exit} end))
      ])
      # Loopback-only control API — how ts status/login/logout reach the
      # endpoint. dashboard:false matters: the default downloads the web
      # dashboard from GitHub on every start.
      | .services = ((.services // []) + [{
          type: "api",
          tag: "api",
          listen: $apiaddr,
          listen_port: $apiport,
          secret: $apisecret,
          dashboard: false
        }])
      | .dns.servers += [{
          tag: "tailscale-dns",
          type: "tailscale",
          endpoint: "tailscale-ep",
          accept_default_resolvers: true
        }]
      | .dns.rules = ((.dns.rules // []) + [{
          domain_suffix: (["ts.net"] + $tsdns | unique),
          server: "tailscale-dns"
        }])
      | .route.rules = ([{
          domain_suffix: (["ts.net"] + $domains + $tsdns | unique),
          outbound: "tailscale-ep"
        }, {
          ip_cidr: (["100.64.0.0/10", "fd7a:115c:a1e0::/48"] + $cidrs),
          outbound: "tailscale-ep"
        }] + (.route.rules // []))
    ' "$CONFIG_FILE")
  printf '%s\n' "$patched" > "$CONFIG_FILE"
}

# Drops the tsexit / tsdns templates in place when they are missing, so an
# install that predates either file still finds it documented on disk. Pass
# any argument to also report files that were already there.
write_list_templates() {
  local announce="${1:-}" file
  mkdir -p "$CONFIG_DIR"
  for file in "$TSEXIT_FILE" "$TSDNS_FILE"; do
    if [[ -f "$file" ]]; then
      [[ -z "$announce" ]] || ok "$file already exists"
      continue
    fi
    case "$file" in
      "$TSEXIT_FILE") emit_tsexit_template > "$file" ;;
      "$TSDNS_FILE")  emit_tsdns_template  > "$file" ;;
    esac
    chmod 0600 "$file"
    ok "wrote $file template (empty by default)"
  done
}

render_config() {
  require_cmd envsubst
  mkdir -p "$CONFIG_DIR" "$CACHE_DIR" "$CLIENT_DIR"
  chmod 0750 "$CONFIG_DIR"
  step "Rendering $CONFIG_FILE"
  ACME_DATA_DIR="$CACHE_DIR/acme" \
    envsubst < <(emit_config_tpl) > "$CONFIG_FILE"
  chmod 0600 "$CONFIG_FILE"
  if ts_enabled; then
    local mode="interactive login"
    [[ -z "${TS_AUTH_KEY:-}" ]] || mode="auth key"
    step "Adding tailscale endpoint (hostname=${TS_HOSTNAME:-${DOMAIN%%.*}}, $mode)"
    write_list_templates
    patch_config_tailscale
    ok "tailscale endpoint enabled"
    if (( ${#TSEXIT_DOMAINS[@]} + ${#TSEXIT_CIDRS[@]} > 0 )); then
      ok "routing +${#TSEXIT_DOMAINS[@]} domain, ${#TSEXIT_CIDRS[@]} cidr from $TSEXIT_FILE"
    fi
    if (( ${#TSDNS_DOMAINS[@]} > 0 )); then
      ok "resolving +${#TSDNS_DOMAINS[@]} domain via tailnet DNS from $TSDNS_FILE"
    fi
  fi
  step "Validating config"
  "$SINGBOX_BIN" check -c "$CONFIG_FILE" \
    || die "config validation failed — inspect $CONFIG_FILE"
  ok "config valid"
}

# ─── share link builders ────────────────────────────────────────────────────
build_share_links() {
  local prefix="${1:+${1}-}"
  VLESS_LINK="vless://${VLESS_UUID}@${DOMAIN}:443?encryption=none&security=reality&sni=${REALITY_DEST_SNI}&fp=chrome&pbk=${REALITY_PUBLIC_KEY}&sid=${REALITY_SHORT_ID}&type=tcp&flow=xtls-rprx-vision#${prefix}REALITY"
  HY2_LINK="hysteria2://${HYSTERIA2_PASSWORD}@${DOMAIN}:443/?sni=${DOMAIN}&obfs=salamander&obfs-password=${HYSTERIA2_OBFS_PASSWORD}#${prefix}HY2"
}

# qrencode -v is a *minimum* (data auto-grows past it), so walk v up
# until every input renders at the same row count → same visual size.
qr_common_version() {
  local v link rows base
  for v in {1..40}; do
    base=""
    local same=1
    for link in "$@"; do
      rows=$( { qrencode -t UTF8 -v "$v" <<< "$link" 2>/dev/null || true; } | wc -l )
      [[ -z $base ]] && base="$rows"
      [[ "$rows" != "$base" ]] && { same=0; break; }
    done
    (( same == 1 )) && { printf '%s' "$v"; return; }
  done
  printf '40'
}

# ─── subcommands ────────────────────────────────────────────────────────────
configure_user_vars() {
  # shellcheck disable=SC1090
  source "$ENV_FILE"

  configure_var DOMAIN           required \
    "Domain pointing at this VPS (DNS-only on Cloudflare)"
  configure_var ACME_EMAIL       required \
    "Contact email for Let's Encrypt registration"
  configure_var CF_API_TOKEN     required \
    "Cloudflare API token (Zone.DNS:Edit + Zone.Zone:Read)"
  configure_var REALITY_DEST_SNI optional \
    "REALITY camouflage destination"

  # install.sh only ever passes --ts-authkey when tailnet egress is wanted.
  if [[ -z "${SINGBOX_TS_ENABLED:-}" && -n "${SINGBOX_TS_AUTH_KEY:-}" ]]; then
    export SINGBOX_TS_ENABLED=yes
  fi
  local ts_default=no
  ts_enabled && ts_default=yes
  configure_bool TS_ENABLED "Enable the Tailscale endpoint?" "$ts_default"
  # set_env exports, so TS_ENABLED/TS_AUTH_KEY/DOMAIN are visible here
  # without re-sourcing.
  if ts_enabled; then
    configure_tailscale_vars
  fi
}

# The three tailnet knobs, shared by `setup`/`configure` and `ts login`.
configure_tailscale_vars() {
  configure_var TS_AUTH_KEY    optional \
    "Tailscale pre-auth key (blank = log in via URL)"
  configure_var TS_HOSTNAME    optional \
    "Tailnet hostname (defaults to ${DOMAIN%%.*} if blank)"
  configure_var TS_EXIT_NODE   optional \
    "Tailscale exit node name or 100.x IP (blank for direct routing)"
}

# configure_var VARNAME required|optional PROMPT_TEXT
#
# Resolution order:
#   1. SINGBOX_<VAR> override (set by install.sh flags) always wins.
#   2. TTY: prompt with current value as `[placeholder]` — Enter keeps it,
#      anything else replaces it. Required + empty re-asks.
#   3. No TTY: keep existing value, or die if required and empty.
#
# Enter meaning "keep" leaves no way to empty a var that already has a value,
# so optional vars also accept CLEAR_SENTINEL (via prompt or override) to
# blank them out.
configure_var() {
  local var="$1" mode="$2" prompt="$3"

  # Split: bash expands `${!fb_var}` *before* the local runs, so combining
  # both into one `local` line evaluates the indirect lookup before fb_var
  # is bound — fails with "invalid indirect expansion".
  local fb_var="SINGBOX_${var}"
  local fb="${!fb_var:-}"
  if [[ -n "$fb" ]]; then
    if [[ "$mode" == "optional" && "$fb" == "$CLEAR_SENTINEL" ]]; then
      set_env "$var" ""
      ok "$var cleared (from \$$fb_var)"
      return 0
    fi
    set_env "$var" "$fb"
    ok "$var ← (from \$$fb_var)"
    return 0
  fi

  local current="${!var:-}"

  if ! has_tty; then
    [[ "$mode" == "required" && -z "$current" ]] \
      && die "$var is empty and no TTY for prompt — set $fb_var or rerun on a TTY"
    return 0
  fi

  # Truncate long values (tokens, keys) to first8…last8 in the placeholder.
  local display="$current"
  (( ${#display} > 30 )) && display="${current:0:8}…${current: -8}"

  # Only advertise clearing where it is allowed, and only where there is
  # something to clear.
  local clear_hint=""
  [[ "$mode" != "optional" || -z "$current" ]] \
    || clear_hint=" ($CLEAR_SENTINEL to clear)"

  local value
  while true; do
    if [[ -n "$current" ]]; then
      ask "$prompt [$display]$clear_hint:"
    else
      ask "$prompt:"
    fi
    read_tty value
    # Clearing an already-empty var is a no-op, so accept the sentinel at
    # every optional prompt even where the hint isn't shown.
    if [[ "$mode" == "optional" && "$value" == "$CLEAR_SENTINEL" ]]; then
      set_env "$var" ""
      ok "$var cleared"
      return 0
    fi
    if [[ -n "$value" ]]; then
      set_env "$var" "$value"
      ok "$var updated"
      return 0
    fi
    if [[ -n "$current" ]]; then
      ok "$var unchanged"
      return 0
    fi
    [[ "$mode" == "optional" ]] && return 0
    err "$var cannot be empty"
  done
}

# configure_bool VARNAME PROMPT_TEXT [DEFAULT]
#
# configure_var for yes/no values: same SINGBOX_<VAR> override and TTY rules,
# but the stored value is normalised to exactly "yes" or "no". DEFAULT applies
# only when the var is unset or empty in $ENV_FILE.
configure_bool() {
  local var="$1" prompt="$2" fallback="${3:-no}"

  local fb_var="SINGBOX_${var}"
  local fb="${!fb_var:-}"
  if [[ -n "$fb" ]]; then
    set_env "$var" "$(norm_bool "$fb")"
    ok "$var ← ${!var} (from \$$fb_var)"
    return 0
  fi

  local current="${!var:-}"
  [[ -n "$current" ]] || current="$fallback"
  current="$(norm_bool "$current")"

  if ! has_tty; then
    set_env "$var" "$current"
    return 0
  fi

  local suffix="[y/N]"
  [[ "$current" != "yes" ]] || suffix="[Y/n]"
  local value=""
  ask "$prompt $suffix:"
  read_tty value
  if [[ -z "$value" ]]; then
    set_env "$var" "$current"
    ok "$var unchanged ($current)"
    return 0
  fi
  set_env "$var" "$(norm_bool "$value")"
  ok "$var = ${!var}"
}

# Returns 0 if the user answers y/Y to $1. Answering nothing, or having no
# TTY, means no.
confirm() {
  local prompt="$1" reply=""
  has_tty || return 1
  ask "$prompt [y/N]:"
  read_tty reply
  [[ "$reply" =~ ^[Yy] ]]
}

# Returns 0 if the user interactively confirms regenerating $1.
confirm_regen() { confirm "regenerate $1?"; }

# maybe_regen NAME GENERATOR — generate if empty, prompt to regen otherwise.
maybe_regen() {
  local name="$1" gen="$2"
  if [[ -z "${!name:-}" ]]; then
    set_env "$name" "$($gen)"
    ok "$name generated"
  elif confirm_regen "$name"; then
    set_env "$name" "$($gen)"
    ok "$name regenerated"
  fi
}

# Empty secrets are auto-generated. Existing ones prompt y/N to regenerate
# (default keep). Regen invalidates clients still using the old value.
# Caller (cmd_setup) must have sourced $ENV_FILE first; set_env exports
# keep our view in sync as we go.
fill_secrets() {
  local v
  for v in VLESS_UUID REALITY_PRIVATE_KEY REALITY_PUBLIC_KEY \
           REALITY_SHORT_ID HYSTERIA2_PASSWORD HYSTERIA2_OBFS_PASSWORD; do
    if [[ -n "${!v:-}" ]] && has_tty; then
      warn "regenerating any secret invalidates every client still using the old value"
      break
    fi
  done

  # REALITY-VLESS group (UUID, short ID, keypair) kept together so a user
  # rotating REALITY can answer y to all three in a row.
  maybe_regen VLESS_UUID       gen_uuid
  maybe_regen REALITY_SHORT_ID gen_short_id
  if [[ -z "${REALITY_PRIVATE_KEY:-}" || -z "${REALITY_PUBLIC_KEY:-}" ]] \
     || confirm_regen "REALITY keypair"; then
    local kp
    kp="$(gen_reality_keypair)"
    set_env REALITY_PRIVATE_KEY "$(awk '/PrivateKey/ {print $2}' <<< "$kp")"
    set_env REALITY_PUBLIC_KEY  "$(awk '/PublicKey/  {print $2}' <<< "$kp")"
    ok "REALITY keypair (re)generated"
  fi

  # Hysteria2 group.
  maybe_regen HYSTERIA2_PASSWORD      gen_password
  maybe_regen HYSTERIA2_OBFS_PASSWORD gen_password
}

cmd_setup() {
  require_root setup
  header "sing-box deployment setup"
  detect_os
  ok "$OS_PRETTY"

  setup_bbr || warn "BBR setup did not complete — see message above"
  setup_packages
  setup_ufw

  header "Installing sing-box binary"
  install_singbox_binary

  header "Installing systemd unit"
  install_systemd_unit

  header "Self-installing wrapper"
  if [[ "$(readlink -f "$0")" != "$WRAPPER_BIN" ]]; then
    install -m 0755 "$0" "$WRAPPER_BIN"
    ok "installed $WRAPPER_BIN"
  else
    ok "wrapper already at $WRAPPER_BIN"
  fi

  header "Configuring $ENV_FILE"
  if [[ ! -f "$ENV_FILE" ]]; then
    mkdir -p "$CONFIG_DIR"
    chmod 0750 "$CONFIG_DIR"
    emit_env_example > "$ENV_FILE"
    chmod 0600 "$ENV_FILE"
    ok "wrote $ENV_FILE template"
  else
    ok "$ENV_FILE already exists"
  fi
  write_list_templates announce
  configure_user_vars
  fill_secrets

  # configure_user_vars enforces the required vars (or dies); no need to
  # re-check before bringing the service up.
  header "Bringing up service"
  cmd_up

  if ts_enabled && [[ -z "${TS_AUTH_KEY:-}" ]]; then
    header "Tailscale"
    hint "no auth key set — attach this node by opening a login URL:"
    hint "    sudo sing-box-ctl ts login"
  fi
}

# ─── tailscale login state ──────────────────────────────────────────────────
# A tailnet login lives inside the running sing-box process (and its state
# directory), not in config.json — so every `ts` action talks to the loopback
# gRPC API that patch_config_tailscale renders next to the endpoint.
ts_api() {
  BOX_API_URL="${API_ADDR}:${API_PORT}" BOX_API_SECRET="${API_SECRET:-}" \
    timeout 15 "$SINGBOX_BIN" api tailscale "$@"
}

# `sing-box api tailscale status` prints "  <Label>:   <value>" lines.
ts_state()    { ts_api status 2>/dev/null | sed -n 's/^ *State: *//p'; }
ts_auth_url() { ts_api status 2>/dev/null | sed -n 's/^ *Log in: *//p'; }

# Configs rendered before the API service existed have no listener to talk to;
# re-render (which restarts) instead of failing with a connection error.
ts_ensure_api_service() {
  require_cmd jq
  [[ -f "$CONFIG_FILE" ]] || die "$CONFIG_FILE not found — run 'sing-box-ctl up' first"
  if ! jq -e '[.services[]? | select(.type == "api")] | length > 0' \
       "$CONFIG_FILE" >/dev/null 2>&1; then
    step "Config predates the control API — re-rendering"
    cmd_up
  elif ! systemctl is-active --quiet sing-box; then
    cmd_up
  fi
}

# The endpoint answers the API only once it has finished starting.
ts_wait_ready() {
  local i
  for i in {1..60}; do
    [[ -z "$(ts_state)" ]] || return 0
    sleep 1
  done
  return 1
}

# Prints a pending login URL on stdout. Exit 1 = already logged in,
# 2 = neither happened before the timeout.
ts_wait_auth() {
  local i url
  for i in {1..90}; do
    url="$(ts_auth_url)"
    if [[ -n "$url" ]]; then
      printf '%s\n' "$url"
      return 0
    fi
    [[ "$(ts_state)" != "Running" ]] || return 1
    sleep 1
  done
  return 2
}

ts_report_auth_url() {
  step "Waiting for a login URL"
  local url="" rc=0
  url="$(ts_wait_auth)" || rc=$?
  case "$rc" in
    0)
      ok "open this URL to attach the node to a tailnet:"
      printf '\n    %s\n\n' "$url"
      hint "the node stays NeedsLogin until the URL is opened and approved"
      hint "check in on it:  sudo sing-box-ctl ts status"
      ;;
    1) ok "node is logged in (state: Running)" ;;
    *)
      warn "no login URL surfaced within 90s"
      hint "inspect:  sudo sing-box-ctl ts status"
      hint "          sudo sing-box-ctl logs"
      ;;
  esac
}

ts_status() {
  load_env
  if ! ts_enabled; then
    warn "tailscale is disabled (TS_ENABLED=${TS_ENABLED:-no})"
    hint "turn it on:  sudo sing-box-ctl ts login"
    return 0
  fi
  ts_ensure_api_service
  header "Tailscale"
  ts_api status \
    || die "could not reach the sing-box API on ${API_ADDR}:${API_PORT} — try 'sudo sing-box-ctl up'"
}

# Enables + configures tailscale if needed, then surfaces the login URL.
# Idempotent: an already-logged-in node just reports Running.
ts_login() {
  load_env
  if ! ts_enabled; then
    header "Enabling tailscale"
    set_env TS_ENABLED yes
    configure_tailscale_vars
    cmd_up
  else
    ts_ensure_api_service
  fi

  header "Tailscale login"
  ts_wait_ready || die "the tailscale endpoint did not come up — see 'sudo sing-box-ctl logs'"
  if [[ "$(ts_state)" == "Running" ]]; then
    ok "already logged in"
    ts_api status || true
    hint "switch tailnets:  sudo sing-box-ctl ts logout"
    return 0
  fi
  if [[ -n "${TS_AUTH_KEY:-}" ]]; then
    hint "TS_AUTH_KEY is set — login is headless; clear it to log in by URL"
  fi
  ts_report_auth_url
}

# Leaves the current tailnet and immediately offers a fresh login URL, so
# "log out of A, log in to B" is one command plus one click.
ts_logout() {
  load_env
  ts_enabled || die "tailscale is disabled — nothing to log out of"
  ts_ensure_api_service

  header "Tailscale logout"
  hint "the node leaves its current tailnet; a fresh login URL follows"
  if has_tty; then
    confirm "log out of the current tailnet?" || die "aborted"
  fi

  # A pre-auth key belongs to the tailnet being left — drop it before logging
  # out, or the next restart silently logs back into that same tailnet.
  if [[ -n "${TS_AUTH_KEY:-}" ]]; then
    step "Clearing TS_AUTH_KEY (it is scoped to the tailnet you are leaving)"
    set_env TS_AUTH_KEY ""
    render_config
    step "Restarting sing-box"
    systemctl restart sing-box
  fi

  ts_wait_ready || die "the tailscale endpoint did not come up — see 'sudo sing-box-ctl logs'"
  step "Logging out"
  # The endpoint answers status a moment before it accepts a logout, so give
  # it a few tries before treating the refusal as real.
  local i logged_out=0
  for i in {1..10}; do
    if ts_api logout; then
      logged_out=1
      break
    fi
    sleep 1
  done
  (( logged_out )) || die "logout failed — inspect 'sudo sing-box-ctl ts status'"
  ok "logged out"
  hint "the old node lingers in that tailnet's admin console — delete it there"
  ts_report_auth_url
}

cmd_ts() {
  require_root ts
  case "${1:-status}" in
    status) ts_status ;;
    login)  ts_login  ;;
    logout) ts_logout ;;
    *)      die "unknown 'ts' action: $1 (want status, login or logout)" ;;
  esac
}

cmd_up() {
  require_root up
  [[ -x "$SINGBOX_BIN" ]] || die "sing-box binary missing — run 'sing-box-ctl setup' first"
  load_env
  require_vars "${SERVER_VARS[@]}"
  render_config
  step "Restarting sing-box"
  systemctl restart sing-box
  local i
  for i in {1..20}; do
    systemctl is-active --quiet sing-box && break
    systemctl is-failed --quiet sing-box && break
    sleep 0.25
  done
  if systemctl is-active --quiet sing-box; then
    ok "sing-box active"
  else
    err "sing-box failed to start — recent logs follow"
    journalctl -u sing-box -n 30 --no-pager
    exit 1
  fi
  hint "follow logs:   sudo sing-box-ctl logs"
  hint "share links:   sudo sing-box-ctl share"
}

cmd_down() {
  require_root down
  step "Stopping sing-box"
  systemctl stop sing-box || true
  ok "stopped"
}

cmd_logs() {
  require_root logs
  exec journalctl -fu sing-box
}

cmd_share() {
  require_root share
  load_env
  require_vars "${CLIENT_VARS[@]}"
  build_share_links "${1:-}"

  mkdir -p "$CLIENT_DIR"
  printf "%s\n%s\n" "$VLESS_LINK" "$HY2_LINK" > "$CLIENT_DIR/subscription.txt"
  printf "%s\n%s\n" "$VLESS_LINK" "$HY2_LINK" \
    | base64 -w0 > "$CLIENT_DIR/subscription.b64"
  chmod 0640 "$CLIENT_DIR/subscription."*

  header "Share links"
  subhead "VLESS-REALITY"
  printf '%s\n\n' "$VLESS_LINK"
  subhead "HYSTERIA2"
  printf '%s\n\n' "$HY2_LINK"
  hint "wrote $CLIENT_DIR/subscription.{txt,b64}"

  if command -v qrencode >/dev/null; then
    header "QR codes"
    local qrv
    qrv="$(qr_common_version "$VLESS_LINK" "$HY2_LINK")"
    subhead "VLESS-REALITY"
    qrencode -t UTF8 -v "$qrv" <<< "$VLESS_LINK"
    printf '\n'
    subhead "HYSTERIA2"
    qrencode -t UTF8 -v "$qrv" <<< "$HY2_LINK"
  else
    hint "(install 'qrencode' for inline QR codes — apt install qrencode)"
  fi

  header "Subscribe URL (optional)"
  hint "host $CLIENT_DIR/subscription.b64 at an unguessable URL — e.g."
  hint "    gh gist create --secret $CLIENT_DIR/subscription.b64"
  hint "then point Shadowrocket → Subscribe at the file's Raw URL."
}

# Re-walk the interactive prompts without redoing the host prep `setup` does.
cmd_configure() {
  require_root configure
  [[ -f "$ENV_FILE" ]] || die "$ENV_FILE not found — run 'sing-box-ctl setup' first"
  header "Configuring $ENV_FILE"
  configure_user_vars
  cmd_up
}

cmd_upgrade() {
  require_root upgrade
  local current latest upgraded=0
  current="$(installed_version)"
  latest="$(latest_version)"
  header "sing-box upgrade"
  ok "current: ${current:-not installed}"
  ok "latest:  $latest"
  if [[ "$current" == "$latest" ]]; then
    ok "already up to date"
  else
    install_singbox_binary "$latest"
    upgraded=1
  fi

  # An upgrade is when people are on the box anyway, so offer the prompts —
  # re-rendering the config is wanted after a version bump regardless.
  if [[ -f "$ENV_FILE" ]] && confirm "review settings now?"; then
    header "Configuring $ENV_FILE"
    configure_user_vars
    cmd_up
    return 0
  fi
  if (( upgraded )) && systemctl is-active --quiet sing-box; then
    step "Restarting sing-box"
    systemctl restart sing-box
    ok "restarted"
  fi
}

cmd_status() {
  require_root status
  systemctl status sing-box --no-pager || true
}

cmd_purge() {
  require_root purge
  [[ "$CONFIG_DIR" =~ /sing-box(/|$) ]] \
    || die "refusing to purge — \$CONFIG_DIR='$CONFIG_DIR' doesn't look like a sing-box config dir"

  header "About to purge sing-box deployment"
  warn "destructive — secrets, certs and client subscriptions will be wiped"
  hint "removes:"
  hint "    $SINGBOX_BIN"
  hint "    $WRAPPER_BIN"
  hint "    $UNIT_FILE"
  hint "    $CONFIG_DIR/  (env + config + acme cache + client/)"
  hint "    ufw allow 443/tcp + 443/udp  (22/tcp preserved)"
  hint "leaves untouched (clean up manually if you want):"
  hint "    cloudflare A/AAAA record + API token"
  hint "    let's encrypt account on LE side (local key under cache/ is wiped; certs auto-expire in 90d)"
  hint "    /etc/sysctl.d/99-bbr.conf, tcp_bbr module"
  hint "    ufw + qrencode + jq apt packages"

  has_tty || die "purge needs a TTY for confirmation"
  printf '\n'
  ask "type 'yes' to proceed:"
  local confirm=""
  read_tty confirm
  [[ "$confirm" == "yes" ]] || die "aborted"

  header "Stopping service"
  if systemctl is-active --quiet sing-box; then
    step "Stopping sing-box"
    systemctl stop sing-box || warn "stop failed — continuing purge anyway"
  fi
  if systemctl is-enabled --quiet sing-box 2>/dev/null; then
    step "Disabling sing-box"
    systemctl disable sing-box >/dev/null 2>&1 || true
  fi
  if [[ -f "$UNIT_FILE" ]]; then
    step "Removing $UNIT_FILE"
    rm -f "$UNIT_FILE"
    systemctl daemon-reload
  fi
  ok "service removed"

  header "Removing files"
  local path
  for path in "$SINGBOX_BIN" "$WRAPPER_BIN"; do
    if [[ -e "$path" ]]; then
      step "Removing $path"
      rm -f "$path"
    fi
  done
  if [[ -d "$CONFIG_DIR" ]]; then
    step "Removing $CONFIG_DIR"
    rm -rf "$CONFIG_DIR"
  fi
  ok "files removed"

  header "Closing firewall ports"
  if command -v ufw >/dev/null && ufw status >/dev/null 2>&1; then
    local rule
    for rule in 443/tcp 443/udp; do
      if ufw status | awk '{print $1}' | grep -qx "$rule"; then
        step "Removing ufw allow $rule"
        ufw delete allow "$rule" >/dev/null 2>&1 || true
      fi
    done
    ok "443 closed (22/tcp preserved)"
  else
    hint "ufw not active — skipping"
  fi

  header "Done"
  hint "manual follow-ups:"
  hint "    cloudflare DNS:  delete A/AAAA for your domain"
  hint "    cloudflare API:  revoke token at dash.cloudflare.com/profile/api-tokens"
}

# ─── dispatcher ─────────────────────────────────────────────────────────────
row() {
  printf '  %s%-18s%s %s\n' "${C_BOLD}" "$1" "${C_RESET}" "$2"
}

usage() {
  header "sing-box deployment wrapper"
  hint "low-exposure VLESS-REALITY (TCP/443) + Hysteria2+salamander (UDP/443)"
  hint "single-binary upstream, systemd-managed, root-only."

  header "Usage"
  hint "sudo sing-box-ctl <command> [args]"

  header "Commands"
  row "setup"          "Install everything: BBR, apt deps (ufw + qrencode + jq), UFW rules, sing-box binary, unit, wrapper, secrets"
  row "configure"      "Re-run the interactive prompts, then re-render + restart"
  row "up"             "Render config + (re)start service"
  row "down"           "Stop service"
  row "logs"           "journalctl -fu sing-box"
  row "status"         "systemctl status sing-box"
  row "share [label]"  "Print share links + QR codes; write subscription.{txt,b64}"
  row "ts <action>"    "Tailscale: status | login (prints the login URL) | logout (leave tailnet, then offer a new URL)"
  row "upgrade"        "Pull latest sing-box release, offer the prompts, restart"
  row "purge"          "Remove service, binaries, config, secrets, 443 ufw rules"

  header "Paths"
  hint "root: $CONFIG_DIR    (override \$SINGBOX_CONFIG_DIR)"

  header "Examples"
  hint "curl -fsSL https://raw.githubusercontent.com/imwithye/sing-box/main/install.sh | sudo bash"
  hint "sudo vim $ENV_FILE && sudo sing-box-ctl up"
  hint "sudo vim $TSEXIT_FILE && sudo sing-box-ctl up   # route public domains via the tailnet"
  hint "sudo vim $TSDNS_FILE && sudo sing-box-ctl up    # resolve private domains via tailnet DNS"
  hint "sudo sing-box-ctl configure"
  hint "sudo sing-box-ctl ts login      # prints a tailscale login URL"
  hint "sudo sing-box-ctl ts logout     # leave this tailnet, join another"
  hint "sudo sing-box-ctl share MY-SG"
  printf '\n'
}

main() {
  case "${1:-}" in
    setup)              shift; cmd_setup     "$@" ;;
    configure|config)   shift; cmd_configure "$@" ;;
    ts|tailscale)       shift; cmd_ts        "$@" ;;
    up)                 shift; cmd_up      "$@" ;;
    down)               shift; cmd_down    "$@" ;;
    logs)               shift; cmd_logs    "$@" ;;
    status)             shift; cmd_status  "$@" ;;
    share)              shift; cmd_share   "$@" ;;
    upgrade|update)     shift; cmd_upgrade "$@" ;;
    purge)              shift; cmd_purge   "$@" ;;
    ""|-h|--help|help)  usage ;;
    *)                  usage; exit 1 ;;
  esac
}

main "$@"
