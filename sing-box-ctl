# ─── env file helpers ───────────────────────────────────────────────────────
load_env() {
  [[ -f "$ENV_FILE" ]] || die "$ENV_FILE not found — run 'sing-box-ctl setup' first"
  set -a; # shellcheck disable=SC1090
  source "$ENV_FILE"
  set +a
}

# Writes KEY=VAL into $ENV_FILE (in-place if KEY exists, appended otherwise)
# and exports it so callers see the new value without re-sourcing.
set_env() {
  local key="$1" val="$2"
  [[ "$val" != *$'\n'* ]] || die "set_env: value for $key contains newline"
  if grep -q "^${key}=" "$ENV_FILE" 2>/dev/null; then
    # Escape sed-replacement metacharacters in $val (\, &, the | delimiter).
    local esc
    esc=$(printf '%s' "$val" | sed -e 's/[\\&|]/\\&/g')
    sed -i "s|^${key}=.*|${key}=${esc}|" "$ENV_FILE"
  else
    printf '%s=%s\n' "$key" "$val" >> "$ENV_FILE"
  fi
  export "$key=$val"
}

# Typed at an optional prompt (or passed as SINGBOX_<VAR>) to blank a value
# that is already set — plain Enter means "keep", so it can't do double duty.
CLEAR_SENTINEL="-"

# Truthy test for TS_ENABLED. Installs predating that key have no such line;
# there, a non-empty TS_AUTH_KEY was what turned tailscale on, so honour it.
ts_enabled() {
  local v="${TS_ENABLED:-}"
  if [[ -z "$v" ]]; then
    [[ -n "${TS_AUTH_KEY:-}" ]]
    return
  fi
  norm_bool "$v" | grep -qx yes
}

# Normalises a human yes/no answer to exactly "yes" or "no".
norm_bool() {
  case "$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')" in
    y|yes|true|on|1) printf 'yes' ;;
    *)               printf 'no'  ;;
  esac
}

require_vars() {
  local missing=0 v
  for v in "$@"; do
    if [[ -z "${!v:-}" ]]; then
      err "$v is empty in $ENV_FILE"
      missing=1
    fi
  done
  (( missing == 0 )) || exit 1
}

