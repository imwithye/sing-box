emit_tsexit_template() {
  cat <<'TPL'
# /etc/sing-box/tsexit — additional destinations to route through tailscale-ep.
#
# Only effective when TS_ENABLED=yes in /etc/sing-box/env.
# When TS_EXIT_NODE is also set, matched traffic egresses through that
# tailnet peer; otherwise it goes via direct tsnet routing.
#
# One entry per line. Comments start with #. Blank lines ignored.
#   Domains:    example.com   *.example.com   (suffix-matched; *. stripped)
#   IPv4/CIDR:  1.2.3.4       10.0.0.0/8      (bare IP → /32)
#   IPv6/CIDR:  2001:db8::1   2001:db8::/32   (bare IP → /128)
#
# Re-read at every `sing-box-ctl up`.
#
# Examples (uncomment to use):
# netflix.com
# *.bbc.co.uk
# 203.0.113.0/24
TPL
}

emit_tsdns_template() {
  cat <<'TPL'
# /etc/sing-box/tsdns — private domains resolved by the tailnet's DNS.
#
# Only effective when TS_ENABLED=yes in /etc/sing-box/env.
#
# Entries here are resolved through tailscale-dns (MagicDNS plus the tailnet's
# split-DNS resolvers) instead of cloudflare-doh, and their traffic also
# egresses through tailscale-ep — which is what a private name whose records
# point at *.ts.net or 100.x needs to work.
#
# Public domains do NOT belong here; put them in /etc/sing-box/tsexit, which
# only changes routing and leaves resolution on cloudflare-doh. Answering
# public names from tailnet DNS breaks TLS for sites such as Claude.
#
# One domain per line. Comments start with #. Blank lines ignored.
# Suffix-matched, so an entry also covers its subdomains; "*." is stripped.
# IP/CIDR entries are ignored — DNS rules match names, not addresses.
#
# Re-read at every `sing-box-ctl up`.
#
# Examples (uncomment to use):
# clickplane.clickhouse-staging.com
# *.corp.example.com
TPL
}

# list_entries FILE — prints FILE's meaningful lines: trimmed, with blank
# lines and #-comments dropped. A missing file prints nothing.
list_entries() {
  [[ -f "$1" ]] || return 0
  local raw entry
  while IFS= read -r raw || [[ -n "$raw" ]]; do
    entry="${raw#"${raw%%[![:space:]]*}"}"
    entry="${entry%"${entry##*[![:space:]]}"}"
    [[ -z "$entry" || "$entry" == \#* ]] && continue
    printf '%s\n' "$entry"
  done < "$1"
}

# json_array [ITEM...] — the arguments as a JSON string array, "[]" for none.
json_array() {
  (( $# > 0 )) || { printf '[]'; return 0; }
  printf '%s\n' "$@" | jq -R . | jq -s .
}

# parse_tsexit — splits $TSEXIT_FILE into TSEXIT_DOMAINS / TSEXIT_CIDRS arrays.
# Missing or all-comment file leaves both empty.
#   IPv4 (with optional /N)   → CIDRS; bare IP gets /32
#   IPv6 (with optional /N)   → CIDRS; bare IP gets /128
#   anything else             → DOMAINS; leading "*." stripped
parse_tsexit() {
  TSEXIT_DOMAINS=()
  TSEXIT_CIDRS=()
  local entry
  while IFS= read -r entry; do
    if [[ "$entry" =~ ^[0-9]+(\.[0-9]+){3}(/[0-9]+)?$ ]]; then
      [[ "$entry" == */* ]] || entry="${entry}/32"
      TSEXIT_CIDRS+=("$entry")
    elif [[ "$entry" == *:* ]]; then
      [[ "$entry" == */* ]] || entry="${entry}/128"
      TSEXIT_CIDRS+=("$entry")
    else
      [[ "$entry" == \*.* ]] && entry="${entry#\*.}"
      TSEXIT_DOMAINS+=("$entry")
    fi
  done < <(list_entries "$TSEXIT_FILE")
}

# parse_tsdns — fills TSDNS_DOMAINS from $TSDNS_FILE. DNS rules match names,
# so IP/CIDR entries are pointless here and get called out instead of used.
parse_tsdns() {
  TSDNS_DOMAINS=()
  local entry
  while IFS= read -r entry; do
    if [[ "$entry" =~ ^[0-9]+(\.[0-9]+){3}(/[0-9]+)?$ || "$entry" == *:* ]]; then
      warn "$TSDNS_FILE: ignoring '$entry' — DNS rules match domains, not IPs"
      continue
    fi
    [[ "$entry" == \*.* ]] && entry="${entry#\*.}"
    TSDNS_DOMAINS+=("$entry")
  done < <(list_entries "$TSDNS_FILE")
}

