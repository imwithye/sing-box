#!/usr/bin/env bash
# sing-box-ctl — one-binary VLESS+REALITY + Hysteria2 deployment wrapper.
#
# Talks straight to the upstream sing-box release binary + a systemd unit.
# No Docker, no compose plugin, no Go runtime: just bash + curl + systemd.

set -euo pipefail

# ─── repo / upstream ────────────────────────────────────────────────────────
REPO_API="${SINGBOX_REPO_API:-https://api.github.com/repos/SagerNet/sing-box}"
REPO_DL="${SINGBOX_REPO_DL:-https://github.com/SagerNet/sing-box}"

# ─── paths ──────────────────────────────────────────────────────────────────
CONFIG_DIR="${SINGBOX_CONFIG_DIR:-/etc/sing-box}"
ENV_FILE="$CONFIG_DIR/env"
CONFIG_FILE="$CONFIG_DIR/config.json"
CACHE_DIR="$CONFIG_DIR/cache"
CLIENT_DIR="$CONFIG_DIR/client"
UNIT_FILE="/etc/systemd/system/sing-box.service"
SINGBOX_BIN="/usr/local/bin/sing-box"
WRAPPER_BIN="/usr/local/bin/sing-box-ctl"

# ─── pretty output ──────────────────────────────────────────────────────────
if [[ -t 1 && "${NO_COLOR:-}" == "" ]]; then
  C_RESET=$'\033[0m'   C_DIM=$'\033[2m'    C_BOLD=$'\033[1m'
  C_RED=$'\033[31m'    C_GREEN=$'\033[32m' C_YELLOW=$'\033[33m'
  C_CYAN=$'\033[36m'
else
  C_RESET= C_DIM= C_BOLD= C_RED= C_GREEN= C_YELLOW= C_CYAN=
fi

header() { printf '\n%s%s━━ %s ━━%s\n' "${C_BOLD}" "${C_CYAN}" "$*" "${C_RESET}"; }
step()   { printf '%s→%s %s\n'         "${C_CYAN}"   "${C_RESET}" "$*"; }
ok()     { printf '  %s✓%s %s\n'       "${C_GREEN}"  "${C_RESET}" "$*"; }
warn()   { printf '  %s⚠%s %s\n'       "${C_YELLOW}" "${C_RESET}" "$*"; }
hint()   { printf '  %s%s%s\n'         "${C_DIM}"    "$*"        "${C_RESET}"; }
err()    { printf '%s✗%s %s\n'         "${C_RED}"    "${C_RESET}" "$*" >&2; }
die()    { err "$*"; exit 1; }

# ─── prerequisites ──────────────────────────────────────────────────────────
require_root() {
  [[ $EUID -eq 0 ]] || die "must run as root — try: sudo sing-box-ctl ${1:-}"
}

require_cmd() {
  command -v "$1" >/dev/null 2>&1 || die "$1 not found in PATH"
}

# ─── embedded templates (heredocs keep this file self-contained) ────────────
emit_env_example() {
  cat <<'TPL'
# ---- Server identity ----------------------------------------------------
# Domain pointing to this VPS. Cloudflare DNS should be DNS-only (gray cloud)
# — do not enable the proxy/orange cloud, sing-box protocols don't go through
# Cloudflare's CDN.
DOMAIN=

# Email used for Let's Encrypt ACME registration.
ACME_EMAIL=

# Cloudflare API token for ACME DNS-01.
# Permissions required:
#   Zone.DNS         : Edit
#   Zone.Zone        : Read
# Scope: include the zone for ${DOMAIN}.
# Create at: https://dash.cloudflare.com/profile/api-tokens
CF_API_TOKEN=

# ---- REALITY camouflage --------------------------------------------------
# Real site whose TLS handshake REALITY will impersonate.
# Requirements: TLS 1.3, X25519, HTTP/2, reachable from your VPS.
# Good defaults: www.apple.com, www.cloudflare.com, www.microsoft.com,
#                addons.mozilla.org, dl.google.com
REALITY_DEST_SNI=www.apple.com
REALITY_DEST_PORT=443

# ---- Generated secrets (filled in by `sing-box-ctl setup`) -------------
# Do not edit by hand unless you intend to invalidate every existing client.
VLESS_UUID=
REALITY_PRIVATE_KEY=
REALITY_PUBLIC_KEY=
REALITY_SHORT_ID=
HYSTERIA2_PASSWORD=
HYSTERIA2_OBFS_PASSWORD=
TPL
}

