emit_systemd_unit() {
  cat <<EOF
[Unit]
Description=sing-box (VLESS+REALITY + Hysteria2)
Documentation=https://github.com/imwithye/sing-box
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=$SINGBOX_BIN run -c $CONFIG_FILE
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
LimitNOFILE=infinity
AmbientCapabilities=CAP_NET_BIND_SERVICE
ReadWritePaths=$CONFIG_DIR
ProtectSystem=strict
ProtectHome=true
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
EOF
}

# ─── env file helpers ───────────────────────────────────────────────────────
load_env() {
  [[ -f "$ENV_FILE" ]] || die "$ENV_FILE not found — run 'sing-box-ctl setup' first"
  set -a; # shellcheck disable=SC1090
  source "$ENV_FILE"
  set +a
}

# Writes KEY=VAL into $ENV_FILE (in-place if KEY exists, appended otherwise)
# and exports it so callers see the new value without re-sourcing.
set_env() {
  local key="$1" val="$2"
  [[ "$val" != *$'\n'* ]] || die "set_env: value for $key contains newline"
  if grep -q "^${key}=" "$ENV_FILE" 2>/dev/null; then
    # Escape sed-replacement metacharacters in $val (\, &, the | delimiter).
    local esc
    esc=$(printf '%s' "$val" | sed -e 's/[\\&|]/\\&/g')
    sed -i "s|^${key}=.*|${key}=${esc}|" "$ENV_FILE"
  else
    printf '%s=%s\n' "$key" "$val" >> "$ENV_FILE"
  fi
  export "$key=$val"
}

require_vars() {
  local missing=0 v
  for v in "$@"; do
    if [[ -z "${!v:-}" ]]; then
      err "$v is empty in $ENV_FILE"
      missing=1
    fi
  done
  (( missing == 0 )) || exit 1
}

# Server vars must be present + non-empty before `up`.
SERVER_VARS=(
  DOMAIN ACME_EMAIL CF_API_TOKEN
  REALITY_DEST_SNI REALITY_DEST_PORT
  VLESS_UUID
  REALITY_PRIVATE_KEY REALITY_PUBLIC_KEY REALITY_SHORT_ID
  HYSTERIA2_PASSWORD HYSTERIA2_OBFS_PASSWORD
)
# Client vars are what a Shadowrocket import / share link needs.
CLIENT_VARS=(
  DOMAIN REALITY_DEST_SNI VLESS_UUID
  REALITY_PUBLIC_KEY REALITY_SHORT_ID
  HYSTERIA2_PASSWORD HYSTERIA2_OBFS_PASSWORD
)

# ─── secret generators ──────────────────────────────────────────────────────
# Only ever called from fill_secrets, which runs after install_singbox_binary,
# so $SINGBOX_BIN is always present.
gen_uuid()            { "$SINGBOX_BIN" generate uuid | tr -d '\r\n'; }
gen_reality_keypair() { "$SINGBOX_BIN" generate reality-keypair; }
gen_short_id()        { openssl rand -hex 8; }
gen_password()        { openssl rand -base64 24 | tr -d '=+/\n' | cut -c1-24; }

# ─── arch detection ─────────────────────────────────────────────────────────
detect_arch() {
  case "$(uname -m)" in
    x86_64|amd64) echo amd64 ;;
    aarch64|arm64) echo arm64 ;;
    armv7l) echo armv7 ;;
    *) die "unsupported arch: $(uname -m)" ;;
  esac
}

# ─── upstream sing-box ──────────────────────────────────────────────────────
latest_version() {
  curl -fsSL "$REPO_API/releases/latest" \
    | grep '"tag_name"' \
    | head -n1 \
    | sed -E 's/.*"v([^"]+)".*/\1/'
}

installed_version() {
  [[ -x "$SINGBOX_BIN" ]] || return 0
  "$SINGBOX_BIN" version 2>/dev/null | awk '/sing-box version/ {print $3}'
}

install_singbox_binary() {
  require_cmd curl
  require_cmd tar
  local version arch tarball url tmp
  version="${1:-$(latest_version)}"
  [[ -n "$version" ]] || die "could not determine latest sing-box release"

  if [[ "$(installed_version)" == "$version" ]]; then
    ok "sing-box ${version} already installed — skipping download"
    return 0
  fi

  arch="$(detect_arch)"
  tarball="sing-box-${version}-linux-${arch}.tar.gz"
  url="$REPO_DL/releases/download/v${version}/${tarball}"

  step "Downloading sing-box ${version} (${arch})"
  tmp="$(mktemp -d)"
  curl -fsSL "$url" -o "$tmp/sb.tgz"
  tar xzf "$tmp/sb.tgz" -C "$tmp"
  install -m 0755 "$tmp/sing-box-${version}-linux-${arch}/sing-box" "$SINGBOX_BIN"
  rm -rf "$tmp"
  ok "installed $SINGBOX_BIN (sing-box $version)"
}

install_systemd_unit() {
  step "Writing $UNIT_FILE"
  emit_systemd_unit > "$UNIT_FILE"
  systemctl daemon-reload
  systemctl enable sing-box >/dev/null 2>&1 || true
  ok "unit installed + enabled"
}

# ─── host prep (BBR + UFW) ──────────────────────────────────────────────────
detect_os() {
  [[ -r /etc/os-release ]] || die "/etc/os-release missing — unknown OS"
  # shellcheck disable=SC1091
  source /etc/os-release
  OS_PRETTY="${PRETTY_NAME:-${ID:-unknown} ${VERSION_ID:-}}"
  IS_DEBIAN_LIKE=0
  case "${ID:-}" in
    ubuntu|debian) IS_DEBIAN_LIKE=1 ;;
    *) [[ "${ID_LIKE:-}" =~ (debian|ubuntu) ]] && IS_DEBIAN_LIKE=1 ;;
  esac
}

setup_bbr() {
  header "TCP BBR"
  local current avail
  current="$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null || echo unknown)"
  avail="$(sysctl -n net.ipv4.tcp_available_congestion_control 2>/dev/null || echo '')"
  ok "current: $current"
  ok "available: $avail"
  if [[ "$current" == "bbr" ]]; then
    ok "BBR already active — skipping"
    return 0
  fi
  if ! grep -qw bbr <<< "$avail"; then
    step "Loading tcp_bbr module"
    if ! modprobe tcp_bbr 2>/dev/null; then
      warn "kernel does not expose tcp_bbr — likely too old (need >= 4.9)"
      return 1
    fi
  fi
  step "Writing /etc/sysctl.d/99-bbr.conf"
  cat > /etc/sysctl.d/99-bbr.conf <<'EOF'
# Managed by sing-box-ctl — TCP BBR for sing-box egress
net.core.default_qdisc = fq
net.ipv4.tcp_congestion_control = bbr
EOF
  sysctl --system >/dev/null
  current="$(sysctl -n net.ipv4.tcp_congestion_control)"
  [[ "$current" == "bbr" ]] || die "expected bbr, got '$current'"
  ok "BBR active"
}

ufw_allow() { ufw allow "$1" comment "$2" >/dev/null; }

# ufw drives the firewall; qrencode lets `share` render inline QR codes;
# jq patches the rendered config when optional features (tailscale) are on.
SYSTEM_PKGS=(ufw qrencode jq)

setup_packages() {
  header "System packages"
  if [[ $IS_DEBIAN_LIKE -ne 1 ]]; then
    warn "$OS_PRETTY — apt auto-install skipped"
    hint "install manually: ${SYSTEM_PKGS[*]}"
    return 0
  fi
  local pkg missing=()
  for pkg in "${SYSTEM_PKGS[@]}"; do
    command -v "$pkg" >/dev/null || missing+=("$pkg")
  done
  if (( ${#missing[@]} == 0 )); then
    ok "${SYSTEM_PKGS[*]} already installed"
    return 0
  fi
  step "Installing ${missing[*]}"
  apt-get update -qq
  DEBIAN_FRONTEND=noninteractive apt-get install -y -qq "${missing[@]}" >/dev/null
  ok "installed: ${missing[*]}"
}

setup_ufw() {
  header "UFW firewall"
  if [[ $IS_DEBIAN_LIKE -ne 1 ]]; then
    warn "$OS_PRETTY — UFW auto-config skipped"
    hint "open these ports manually with your firewall tooling:"
    hint "    22/tcp  ssh"
    hint "    443/tcp sing-box VLESS-REALITY"
    hint "    443/udp sing-box Hysteria2"
    return 0
  fi
  ufw --force default deny incoming  >/dev/null
  ufw --force default allow outgoing >/dev/null
  ufw_allow 22/tcp  ssh
  ufw_allow 443/tcp 'sing-box vless-reality'
  ufw_allow 443/udp 'sing-box hysteria2'
  ufw --force enable >/dev/null
  ok "ufw active (22/tcp, 443/tcp, 443/udp open)"
}

# ─── render config ──────────────────────────────────────────────────────────
# Patch the rendered config to add a tailscale endpoint, DNS server, and
# route rule. Activated only when TS_AUTH_KEY is non-empty. Hostname falls
# back to the first DNS label of DOMAIN.
patch_config_tailscale() {
  require_cmd jq
  local host="${TS_HOSTNAME:-${DOMAIN%%.*}}" state="$CACHE_DIR/tailscale"
  mkdir -p "$state"
  local patched
  patched=$(jq \
    --arg key   "$TS_AUTH_KEY" \
    --arg host  "$host" \
    --arg state "$state" '
      .endpoints = ((.endpoints // []) + [{
        type: "tailscale",
        tag: "tailscale-ep",
        auth_key: $key,
        hostname: $host,
        state_directory: $state,
        ephemeral: false
      }])
      | .dns.servers += [{
          tag: "tailscale-dns",
          type: "tailscale",
          endpoint: "tailscale-ep",
          accept_default_resolvers: true
        }]
      | .dns.rules = ((.dns.rules // []) + [{
          domain_suffix: ["ts.net"],
          server: "tailscale-dns"
        }])
      | .route.rules = ([{
          ip_cidr: ["100.64.0.0/10", "fd7a:115c:a1e0::/48"],
          outbound: "tailscale-ep"
        }] + (.route.rules // []))
    ' "$CONFIG_FILE")
  printf '%s\n' "$patched" > "$CONFIG_FILE"
}

render_config() {
  require_cmd envsubst
  mkdir -p "$CONFIG_DIR" "$CACHE_DIR" "$CLIENT_DIR"
  chmod 0750 "$CONFIG_DIR"
  step "Rendering $CONFIG_FILE"
  ACME_DATA_DIR="$CACHE_DIR/acme" \
    envsubst < <(emit_config_tpl) > "$CONFIG_FILE"
  chmod 0600 "$CONFIG_FILE"
  if [[ -n "${TS_AUTH_KEY:-}" ]]; then
    step "Adding tailscale endpoint (hostname=${TS_HOSTNAME:-${DOMAIN%%.*}})"
    patch_config_tailscale
    ok "tailscale endpoint enabled"
  fi
  step "Validating config"
  "$SINGBOX_BIN" check -c "$CONFIG_FILE" \
    || die "config validation failed — inspect $CONFIG_FILE"
  ok "config valid"
}

# ─── share link builders ────────────────────────────────────────────────────
build_share_links() {
  local prefix="${1:+${1}-}"
  VLESS_LINK="vless://${VLESS_UUID}@${DOMAIN}:443?encryption=none&security=reality&sni=${REALITY_DEST_SNI}&fp=chrome&pbk=${REALITY_PUBLIC_KEY}&sid=${REALITY_SHORT_ID}&type=tcp&flow=xtls-rprx-vision#${prefix}REALITY"
  HY2_LINK="hysteria2://${HYSTERIA2_PASSWORD}@${DOMAIN}:443/?sni=${DOMAIN}&obfs=salamander&obfs-password=${HYSTERIA2_OBFS_PASSWORD}#${prefix}HY2"
}

# qrencode -v is a *minimum* (data auto-grows past it), so walk v up
# until every input renders at the same row count → same visual size.
qr_common_version() {
  local v link rows base
  for v in {1..40}; do
    base=""
    local same=1
    for link in "$@"; do
      rows=$( { qrencode -t UTF8 -v "$v" <<< "$link" 2>/dev/null || true; } | wc -l )
      [[ -z $base ]] && base="$rows"
      [[ "$rows" != "$base" ]] && { same=0; break; }
    done
    (( same == 1 )) && { printf '%s' "$v"; return; }
  done
  printf '40'
}

# ─── subcommands ────────────────────────────────────────────────────────────
configure_user_vars() {
  # shellcheck disable=SC1090
  source "$ENV_FILE"

  configure_var DOMAIN           required \
    "Domain pointing at this VPS (DNS-only on Cloudflare)"
  configure_var ACME_EMAIL       required \
    "Contact email for Let's Encrypt registration"
  configure_var CF_API_TOKEN     required \
    "Cloudflare API token (Zone.DNS:Edit + Zone.Zone:Read)"
  configure_var REALITY_DEST_SNI optional \
    "REALITY camouflage destination"
  configure_var TS_AUTH_KEY      optional \
    "Tailscale auth key — enables tailnet egress (blank to skip)"
  # set_env exports, so TS_AUTH_KEY/DOMAIN are visible here without re-sourcing.
  if [[ -n "${TS_AUTH_KEY:-}" ]]; then
    configure_var TS_HOSTNAME    optional \
      "Tailnet hostname (defaults to ${DOMAIN%%.*} if blank)"
  fi
}

# configure_var VARNAME required|optional PROMPT_TEXT
#
# Resolution order:
#   1. SINGBOX_<VAR> override (set by install.sh flags) always wins.
#   2. TTY: prompt with current value as `[placeholder]` — Enter keeps it,
#      anything else replaces it. Required + empty re-asks.
#   3. No TTY: keep existing value, or die if required and empty.
configure_var() {
  local var="$1" mode="$2" prompt="$3"

  local fb_var="SINGBOX_${var}" fb="${!fb_var:-}"
  if [[ -n "$fb" ]]; then
    set_env "$var" "$fb"
    ok "$var ← (from \$$fb_var)"
    return 0
  fi

  local current="${!var:-}"

  if [[ ! -e /dev/tty || ! -r /dev/tty ]]; then
    [[ "$mode" == "required" && -z "$current" ]] \
      && die "$var is empty and no TTY for prompt — set $fb_var or rerun on a TTY"
    return 0
  fi

  # Truncate long values (tokens, keys) to first8…last8 in the placeholder.
  local display="$current"
  (( ${#display} > 30 )) && display="${current:0:8}…${current: -8}"

  local value
  while true; do
    if [[ -n "$current" ]]; then
      ask "$prompt [$display]:"
    else
      ask "$prompt:"
    fi
    read -r value </dev/tty || value=""
    if [[ -n "$value" ]]; then
      set_env "$var" "$value"
      ok "$var updated"
      return 0
    fi
    if [[ -n "$current" ]]; then
      ok "$var unchanged"
      return 0
    fi
    [[ "$mode" == "optional" ]] && return 0
    err "$var cannot be empty"
  done
}

# Returns 0 if the user interactively confirms regenerating $1.
# Returns 1 (no regen) when there's no TTY or the answer isn't y/Y.
confirm_regen() {
  local name="$1" reply=""
  [[ -e /dev/tty && -r /dev/tty ]] || return 1
  ask "regenerate $name? [y/N]:"
  read -r reply </dev/tty || reply=""
  [[ "$reply" =~ ^[Yy] ]]
}

# Empty secrets are auto-generated. Existing ones prompt y/N to regenerate
# (default keep). Regen invalidates clients still using the old value.
# Caller (cmd_setup) must have sourced $ENV_FILE first; set_env exports
# keep our view in sync as we go.
fill_secrets() {
  local changed=0 spec name gen v

  for v in VLESS_UUID REALITY_PRIVATE_KEY REALITY_PUBLIC_KEY \
           REALITY_SHORT_ID HYSTERIA2_PASSWORD HYSTERIA2_OBFS_PASSWORD; do
    if [[ -n "${!v:-}" ]] && [[ -e /dev/tty && -r /dev/tty ]]; then
      warn "regenerating any secret invalidates every client still using the old value"
      break
    fi
  done

  for spec in \
      VLESS_UUID:gen_uuid \
      REALITY_SHORT_ID:gen_short_id \
      HYSTERIA2_PASSWORD:gen_password \
      HYSTERIA2_OBFS_PASSWORD:gen_password; do
    name="${spec%%:*}"; gen="${spec#*:}"
    if [[ -z "${!name:-}" ]]; then
      set_env "$name" "$($gen)"
      ok "$name generated"
      changed=1
    elif confirm_regen "$name"; then
      set_env "$name" "$($gen)"
      ok "$name regenerated"
      changed=1
    fi
  done

  if [[ -z "${REALITY_PRIVATE_KEY:-}" || -z "${REALITY_PUBLIC_KEY:-}" ]] \
     || confirm_regen "REALITY keypair"; then
    local kp
    kp="$(gen_reality_keypair)"
    set_env REALITY_PRIVATE_KEY "$(awk '/PrivateKey/ {print $2}' <<< "$kp")"
    set_env REALITY_PUBLIC_KEY  "$(awk '/PublicKey/  {print $2}' <<< "$kp")"
    ok "REALITY keypair (re)generated"
    changed=1
  fi

  # `(( cond )) && cmd` as last statement aborts under set -e when cond is false.
  if (( changed == 0 )); then
    ok "all secrets already populated"
  fi
}

cmd_setup() {
  require_root setup
  header "sing-box deployment setup"
  detect_os
  ok "$OS_PRETTY"

  setup_bbr || warn "BBR setup did not complete — see message above"
  setup_packages
  setup_ufw

  header "Installing sing-box binary"
  install_singbox_binary

  header "Installing systemd unit"
  install_systemd_unit

  header "Self-installing wrapper"
  if [[ "$(readlink -f "$0")" != "$WRAPPER_BIN" ]]; then
    install -m 0755 "$0" "$WRAPPER_BIN"
    ok "installed $WRAPPER_BIN"
  else
    ok "wrapper already at $WRAPPER_BIN"
  fi

  header "Configuring $ENV_FILE"
  if [[ ! -f "$ENV_FILE" ]]; then
    mkdir -p "$CONFIG_DIR"
    chmod 0750 "$CONFIG_DIR"
    emit_env_example > "$ENV_FILE"
    chmod 0600 "$ENV_FILE"
    ok "wrote $ENV_FILE template"
  else
    ok "$ENV_FILE already exists"
  fi
  configure_user_vars
  fill_secrets

  # configure_user_vars enforces the required vars (or dies); no need to
  # re-check before bringing the service up.
  header "Bringing up service"
  cmd_up
}

cmd_up() {
  require_root up
  [[ -x "$SINGBOX_BIN" ]] || die "sing-box binary missing — run 'sing-box-ctl setup' first"
  load_env
  require_vars "${SERVER_VARS[@]}"
  render_config
  step "Restarting sing-box"
  systemctl restart sing-box
  local i
  for i in {1..20}; do
    systemctl is-active --quiet sing-box && break
    systemctl is-failed --quiet sing-box && break
    sleep 0.25
  done
  if systemctl is-active --quiet sing-box; then
    ok "sing-box active"
  else
    err "sing-box failed to start — recent logs follow"
    journalctl -u sing-box -n 30 --no-pager
    exit 1
  fi
  hint "follow logs:   sudo sing-box-ctl logs"
  hint "share links:   sudo sing-box-ctl share"
}

cmd_down() {
  require_root down
  step "Stopping sing-box"
  systemctl stop sing-box || true
  ok "stopped"
}

cmd_logs() {
  require_root logs
  exec journalctl -fu sing-box
}

cmd_share() {
  require_root share
  load_env
  require_vars "${CLIENT_VARS[@]}"
  build_share_links "${1:-}"

  mkdir -p "$CLIENT_DIR"
  printf "%s\n%s\n" "$VLESS_LINK" "$HY2_LINK" > "$CLIENT_DIR/subscription.txt"
  printf "%s\n%s\n" "$VLESS_LINK" "$HY2_LINK" \
    | base64 -w0 > "$CLIENT_DIR/subscription.b64"
  chmod 0640 "$CLIENT_DIR/subscription."*

  header "Share links"
  subhead "VLESS-REALITY"
  printf '%s\n\n' "$VLESS_LINK"
  subhead "HYSTERIA2"
  printf '%s\n\n' "$HY2_LINK"
  hint "wrote $CLIENT_DIR/subscription.{txt,b64}"

  if command -v qrencode >/dev/null; then
    header "QR codes"
    local qrv
    qrv="$(qr_common_version "$VLESS_LINK" "$HY2_LINK")"
    subhead "VLESS-REALITY"
    qrencode -t UTF8 -v "$qrv" <<< "$VLESS_LINK"
    printf '\n'
    subhead "HYSTERIA2"
    qrencode -t UTF8 -v "$qrv" <<< "$HY2_LINK"
  else
    hint "(install 'qrencode' for inline QR codes — apt install qrencode)"
  fi

  header "Subscribe URL (optional)"
  hint "host $CLIENT_DIR/subscription.b64 at an unguessable URL — e.g."
  hint "    gh gist create --secret $CLIENT_DIR/subscription.b64"
  hint "then point Shadowrocket → Subscribe at the file's Raw URL."
}

cmd_upgrade() {
  require_root upgrade
  local current latest
  current="$(installed_version)"
  latest="$(latest_version)"
  header "sing-box upgrade"
  ok "current: ${current:-not installed}"
  ok "latest:  $latest"
  if [[ "$current" == "$latest" ]]; then
    ok "already up to date"
    return 0
  fi
  install_singbox_binary "$latest"
  if systemctl is-active --quiet sing-box; then
    step "Restarting sing-box"
    systemctl restart sing-box
    ok "restarted"
  fi
}

cmd_status() {
  require_root status
  systemctl status sing-box --no-pager || true
}

cmd_purge() {
  require_root purge
  [[ "$CONFIG_DIR" =~ /sing-box(/|$) ]] \
    || die "refusing to purge — \$CONFIG_DIR='$CONFIG_DIR' doesn't look like a sing-box config dir"

  header "About to purge sing-box deployment"
  warn "destructive — secrets, certs and client subscriptions will be wiped"
  hint "removes:"
  hint "    $SINGBOX_BIN"
  hint "    $WRAPPER_BIN"
  hint "    $UNIT_FILE"
  hint "    $CONFIG_DIR/  (env + config + acme cache + client/)"
  hint "    ufw allow 443/tcp + 443/udp  (22/tcp preserved)"
  hint "leaves untouched (clean up manually if you want):"
  hint "    cloudflare A/AAAA record + API token"
  hint "    let's encrypt account on LE side (local key under cache/ is wiped; certs auto-expire in 90d)"
  hint "    /etc/sysctl.d/99-bbr.conf, tcp_bbr module"
  hint "    ufw + qrencode + jq apt packages"

  [[ -e /dev/tty && -r /dev/tty ]] || die "purge needs a TTY for confirmation"
  printf '\n'
  ask "type 'yes' to proceed:"
  local confirm=""
  read -r confirm </dev/tty || true
  [[ "$confirm" == "yes" ]] || die "aborted"

  header "Stopping service"
  if systemctl is-active --quiet sing-box; then
    step "Stopping sing-box"
    systemctl stop sing-box || warn "stop failed — continuing purge anyway"
  fi
  if systemctl is-enabled --quiet sing-box 2>/dev/null; then
    step "Disabling sing-box"
    systemctl disable sing-box >/dev/null 2>&1 || true
  fi
  if [[ -f "$UNIT_FILE" ]]; then
    step "Removing $UNIT_FILE"
    rm -f "$UNIT_FILE"
    systemctl daemon-reload
  fi
  ok "service removed"

  header "Removing files"
  local path
  for path in "$SINGBOX_BIN" "$WRAPPER_BIN"; do
    if [[ -e "$path" ]]; then
      step "Removing $path"
      rm -f "$path"
    fi
  done
  if [[ -d "$CONFIG_DIR" ]]; then
    step "Removing $CONFIG_DIR"
    rm -rf "$CONFIG_DIR"
  fi
  ok "files removed"

  header "Closing firewall ports"
  if command -v ufw >/dev/null && ufw status >/dev/null 2>&1; then
    local rule
    for rule in 443/tcp 443/udp; do
      if ufw status | awk '{print $1}' | grep -qx "$rule"; then
        step "Removing ufw allow $rule"
        ufw delete allow "$rule" >/dev/null 2>&1 || true
      fi
    done
    ok "443 closed (22/tcp preserved)"
  else
    hint "ufw not active — skipping"
  fi

  header "Done"
  hint "manual follow-ups:"
  hint "    cloudflare DNS:  delete A/AAAA for your domain"
  hint "    cloudflare API:  revoke token at dash.cloudflare.com/profile/api-tokens"
}

# ─── dispatcher ─────────────────────────────────────────────────────────────
row() {
  printf '  %s%-18s%s %s\n' "${C_BOLD}" "$1" "${C_RESET}" "$2"
}

usage() {
  header "sing-box deployment wrapper"
  hint "low-exposure VLESS-REALITY (TCP/443) + Hysteria2+salamander (UDP/443)"
  hint "single-binary upstream, systemd-managed, root-only."

  header "Usage"
  hint "sudo sing-box-ctl <command> [args]"

  header "Commands"
  row "setup"          "Install everything: BBR, apt deps (ufw + qrencode + jq), UFW rules, sing-box binary, unit, wrapper, secrets"
  row "up"             "Render config + (re)start service"
  row "down"           "Stop service"
  row "logs"           "journalctl -fu sing-box"
  row "status"         "systemctl status sing-box"
  row "share [label]"  "Print share links + QR codes; write subscription.{txt,b64}"
  row "upgrade"        "Pull latest sing-box release + restart"
  row "purge"          "Remove service, binaries, config, secrets, 443 ufw rules"

  header "Paths"
  hint "root: $CONFIG_DIR    (override \$SINGBOX_CONFIG_DIR)"

  header "Examples"
  hint "curl -fsSL https://raw.githubusercontent.com/imwithye/sing-box/main/install.sh | sudo bash"
  hint "sudo vim $ENV_FILE && sudo sing-box-ctl up"
  hint "sudo sing-box-ctl share MY-SG"
  printf '\n'
}

main() {
  case "${1:-}" in
    setup)              shift; cmd_setup   "$@" ;;
    up)                 shift; cmd_up      "$@" ;;
    down)               shift; cmd_down    "$@" ;;
    logs)               shift; cmd_logs    "$@" ;;
    status)             shift; cmd_status  "$@" ;;
    share)              shift; cmd_share   "$@" ;;
    upgrade)            shift; cmd_upgrade "$@" ;;
    purge)              shift; cmd_purge   "$@" ;;
    ""|-h|--help|help)  usage ;;
    *)                  usage; exit 1 ;;
  esac
}

main "$@"
